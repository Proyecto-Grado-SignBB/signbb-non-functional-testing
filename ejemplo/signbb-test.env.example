# Copia este archivo a .env en la raíz del repositorio, completa los valores
# reales y aplica chmod 600. El archivo .env está ignorado por Git.
#
# No guardes credenciales reales dentro de este archivo de ejemplo.

BASE_URL=https://consulta.canguritos.tech

# Cuentas del seed (o cuentas equivalentes con cada rol)
PADRE_CORREO=padre.ejemplo@signbb.local
PADRE_CONTRASENA=cambiar
MEDICO_CORREO=medico.ejemplo@signbb.local
MEDICO_CONTRASENA=cambiar
SUPERVISOR_CORREO=supervisor@signbb.local
SUPERVISOR_CONTRASENA=cambiar

# Carga
VUS=100
DURACION=5m
LOGIN_USUARIOS=50
LOGIN_CONTRASENA=cambiar
LOGIN_PAUSA=1

# Cuentas desechables de seguridad (se crean y se borran)
TEST_USER_PASSWORD=cambiar
SEG_CONTRASENA=cambiar

# Acceso al VPS para consultar/limpiar la base
VPS_HOST=signbb@2.25.152.145
VPS_KEY=/ruta/a/la/clave/signbb_vps_ed25519
VPS_DIR=/opt/signbb/signbb-frontend/deploy
